# Shared secret the engine must send as the X-API-Key header.
# The enrich endpoint returns 503 until this is set — it never falls open.
MERCHANT_API_KEY=change-me

# --- Phase 2: the curation loop (all optional) -------------------------------
# With no LLM key the proposer abstains on everything, which is the right
# default: a server with no model should add nothing rather than guess.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LANGSEARCH_API_KEY=

# How often a name must be asked for before it is worth proposing. Also acts as
# a merchant/person filter: individuals appear in one statement, merchants in many.
MERCHANT_MIN_HIT_COUNT=3
# Distinct statements a name must appear in (counted via the engine's opaque
# statement_id). The stronger privacy gate: resubmitting one statement cannot
# raise it, and requests without a statement id never count towards it.
MERCHANT_MIN_STATEMENT_COUNT=3

# Auto-promotion thresholds. High-severity categories (gambling, bnpl_lending,
# crypto, loan_emi) additionally require both the grounded and parametric paths
# to agree; set MERCHANT_REQUIRE_AGREEMENT=0 to hold everything to one bar.
MERCHANT_PROMOTE_THRESHOLD=0.75
MERCHANT_HIGH_SEVERITY_THRESHOLD=0.90
MERCHANT_REQUIRE_AGREEMENT=1
